# Prity AI configuration
DEBUG=true
HOST=127.0.0.1
PORT=8000

CHARACTER_NAME=Prity
APP_NAME=Prity AI

# AI – shown as "Prity". Backend talks to local model server.
AI_PROVIDER=prity
AI_MODEL=prity
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# Local model server (OpenAI-compatible)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.2

# To use OpenAI instead, set these in your local .env file (never commit that file):
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-new-api-key-here

# The app's OpenRouter client reads OPENROUTER_API_KEY and AI_MODEL.
# Set AI_MODEL to a model ID available to your OpenRouter account, e.g.:
# AI_MODEL=openai/gpt-4o-mini
# OPENROUTER_API_KEY=your-openrouter-key-here
# Audio attachments use a separate audio-capable OpenRouter model:
# OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash

# Optional Gemini cloud
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

LOCAL_MODE=true
ONLINE_SEARCH_ENABLED=false

WAKE_WORD=hello prity
WAKE_WORD_ENABLED=true
STT_ENGINE=browser
TTS_ENGINE=browser
DEFAULT_LANGUAGE=en

PERSONALITY_STYLE=friendly
MEMORY_ENABLED=true
CAMERA_ENABLED=false
